<GuiXml>
    <Controls>
        <Control name="TheQuestingGuideGroup_ZoneDetailControl" virtual="true">
            <OnInitialized>
                local scrollChild = GetControl(self:GetParent(),"ZoneInfoContainerScrollChild")
                self:SetParent(scrollChild)
            </OnInitialized>
        </Control>

        <Control name="TheQuestingGuideGroup_ZoneStepControl" virtual="true">
            <OnInitialized>
                local scrollChild = GetControl(self:GetParent(),"ZoneStepContainerScrollChild")
                self:SetParent(scrollChild)
            </OnInitialized>
        </Control>

        <Label name="TheQuestingGuideGroup_DetailText" inherits="ZO_Cadwell_ZoneDetailControl"
            font="ZoFontWinH4" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"
            virtual="true" />
        <Label name="TheQuestingGuideGroup_StepText" inherits="ZO_Cadwell_ZoneStepControl"
            font="ZoFontWinH4" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL"
            virtual="true" />

        <TopLevelControl name="TheQuestingGuideGroup_Top" inherits="ZO_RightPanelFootPrint"
            hidden="true">
            <OnInitialized>
                TheQuestingGuideGroup_Initialize(self, GetString(TQG_TAB_GROUP))
            </OnInitialized>
            <OnEffectivelyShown>
                TheQuestingGuideGroup_OnShown()
            </OnEffectivelyShown>
            <Controls>
                <Control name="$(parent)NavigationContainer" inherits="ZO_ScrollContainer">
                    <Dimensions x="335" />
                    <Anchor point="TOPLEFT" offsetX="5" offsetY="12" />
                    <Anchor point="BOTTOMLEFT" />
                </Control>

                <Control name="$(parent)ZoneInfoContainer" inherits="ZO_ScrollContainer">
                    <Dimensions x="550" />
                    <Anchor point="TOPRIGHT" offsetX="-33" offsetY="60" />
                    <Anchor point="BOTTOMRIGHT" relativePoint="RIGHT" offsetX="-33" offsetY="-40" />
                </Control>

                <Label name="$(parent)TitleText" font="ZoFontWinH2" modifyTextType="UPPERCASE"
                    color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <OnInitialized>
                        local scrollChild =
                        GetControl(self:GetParent(),"ZoneInfoContainerScrollChild")
                        self:SetParent(scrollChild)
                        self:SetAnchor(TOPLEFT, nil, TOPLEFT, 0, 0)
                        self:SetWidth(500)
                    </OnInitialized>
                </Label>

                <Label name="$(parent)DescriptionText" inherits="ZO_Cadwell_DetailText">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)TitleText"
                        relativePoint="BOTTOMLEFT" offsetX="25" offsetY="5" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)TitleText"
                        relativePoint="BOTTOMRIGHT" offsetY="5" />
                </Label>

                <Control name="$(parent)ZoneStepContainer" inherits="ZO_ScrollContainer">
                    <Dimensions x="550" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)ZoneInfoContainer"
                        relativePoint="BOTTOMRIGHT" offsetY="5" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-33" />
                </Control>

                <Texture name="$(parent)Divider"
                    textureFile="EsoUI/Art/Quest/questJournal_divider.dds">
                    <Dimensions x="512" y="4" />
                    <OnInitialized>
                        local scrollChild =
                        GetControl(self:GetParent(),"ZoneStepContainerScrollChild")
                        self:SetParent(scrollChild)
                        self:SetAnchor(TOPLEFT, nil, TOPLEFT, 0, 0)
                    </OnInitialized>
                </Texture>

                <Label name="$(parent)ObjectivesText" inherits="ZO_Cadwell_StepText"
                    text="SI_CADWELL_OBJECTIVES" font="ZoFontWinH3" modifyTextType="UPPERCASE"
                    color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Divider" relativePoint="BOTTOMLEFT"
                        offsetY="10" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Divider"
                        relativePoint="BOTTOMRIGHT" offsetX="-12" offsetY="10" />
                </Label>
            </Controls>

        </TopLevelControl>
    </Controls>
</GuiXml>